#!/usr/bin/env python3
# skill-feedback-managed-wrapper: v1
# metadata: {"feature":"cli","schema":1,"skill":"presentation","success_exit_codes":[],"target":"cli/present"}
"""Generated adapter. Reconcile with `skill-feedback wrapper --apply`."""
from __future__ import annotations

import os
import shutil
import sys
from pathlib import Path

_SKILL = 'presentation'
_FEATURE = 'cli'
_SUCCESS_EXIT_CODES = ()
_TARGET = (Path(__file__).resolve().parent / 'cli/present').resolve()
_COMMAND = [str(_TARGET), *sys.argv[1:]]
_RUN_OPTIONS = [
    item
    for code in _SUCCESS_EXIT_CODES
    for item in ("--success-exit-code", str(code))
]
_FEEDBACK = shutil.which("skill-feedback")
if _FEEDBACK is None or Path(_FEEDBACK).resolve() == Path(__file__).resolve():
    os.execv(str(_TARGET), _COMMAND)
os.execv(
    _FEEDBACK,
    [
        _FEEDBACK,
        "run",
        _SKILL,
        "--feature",
        _FEATURE,
        *_RUN_OPTIONS,
        "--",
        *_COMMAND,
    ],
)
