{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://presentation.skill/schemas/delivery.schema.json",
  "title": "delivery/<date>[-<module>].yaml",
  "type": "object",
  "required": [
    "schema_version",
    "talk",
    "date",
    "recorded",
    "modules"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "talk": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "recorded": {
      "type": "string",
      "format": "date-time"
    },
    "note": {
      "type": "string"
    },
    "modules": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[0-9]{2}-[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "script": {
            "type": "object",
            "required": [
              "version",
              "approved",
              "receipt_sha256"
            ],
            "additionalProperties": false,
            "properties": {
              "version": {
                "type": "string",
                "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
              },
              "approved": {
                "type": "boolean"
              },
              "receipt_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "deck": {
            "type": "object",
            "required": [
              "version",
              "approved",
              "receipt_sha256"
            ],
            "additionalProperties": false,
            "properties": {
              "version": {
                "type": "string",
                "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
              },
              "approved": {
                "type": "boolean"
              },
              "receipt_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    }
  }
}
