{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://presentation.skill/schemas/talk.schema.json",
  "title": "audience/talk.yaml (talk metadata)",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "title",
    "status",
    "format",
    "occasion",
    "country",
    "language",
    "modules"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "standard": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "preparing",
        "delivered",
        "cancelled"
      ]
    },
    "format": {
      "enum": [
        "online",
        "onsite",
        "hybrid"
      ]
    },
    "occasion": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "country": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
    },
    "date": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        {
          "type": "object",
          "required": [
            "value"
          ],
          "additionalProperties": false,
          "properties": {
            "value": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "source": {
              "type": "string",
              "description": "file under audience/ that confirmed this value"
            },
            "time": {
              "type": "string"
            },
            "tz": {
              "type": "string"
            }
          }
        }
      ]
    },
    "slot_minutes": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "object",
          "required": [
            "value"
          ],
          "additionalProperties": false,
          "properties": {
            "value": {
              "type": "integer",
              "minimum": 1
            },
            "source": {
              "type": "string",
              "description": "file under audience/ that confirmed this value"
            },
            "time": {
              "type": "string"
            },
            "tz": {
              "type": "string"
            }
          }
        }
      ]
    },
    "audience": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "summary": {
          "type": "string"
        },
        "institutions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "size": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "object",
              "required": [
                "value"
              ],
              "additionalProperties": false,
              "properties": {
                "value": {
                  "type": "integer",
                  "minimum": 0
                },
                "source": {
                  "type": "string",
                  "description": "file under audience/ that confirmed this value"
                },
                "time": {
                  "type": "string"
                },
                "tz": {
                  "type": "string"
                }
              }
            }
          ]
        }
      }
    },
    "contacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "email": {
            "type": "string"
          }
        }
      }
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "script",
          "deck"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9]{2}-[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string"
          },
          "minutes": {
            "type": "integer",
            "minimum": 1
          },
          "script": {
            "type": "boolean"
          },
          "deck": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
