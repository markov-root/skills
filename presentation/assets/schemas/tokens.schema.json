{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://presentation.skill/schemas/tokens.schema.json",
  "title": "brand tokens (ADR 0008)",
  "type": "object",
  "required": [
    "schema_version",
    "name",
    "version",
    "color",
    "font"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
    },
    "color": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          {
            "type": "object",
            "required": [
              "value"
            ],
            "additionalProperties": false,
            "properties": {
              "value": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              },
              "source": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            }
          }
        ]
      }
    },
    "font": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "family"
        ],
        "additionalProperties": false,
        "properties": {
          "family": {
            "type": "string"
          },
          "weight": {
            "type": "integer"
          },
          "file": {
            "type": "string"
          },
          "source": {
            "type": "string"
          }
        }
      }
    },
    "size": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "number",
        "exclusiveMinimum": 0
      }
    },
    "logo": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "roles": {
      "type": "object",
      "description": "semantic role -> colour token name (ADR 0008); a role without an entry reads the colour token named after it; a list-valued role (series, score, categorical, \u2026) names an ordered set of colour tokens",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "properties": {
        "series": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "minItems": 1
        }
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "minItems": 1
          }
        ]
      }
    }
  }
}
