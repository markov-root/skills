{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://presentation.skill/schemas/approvals.schema.json",
  "title": "approvals.yaml",
  "type": "object",
  "required": [
    "schema_version",
    "approvals"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "version",
          "at",
          "by",
          "checks"
        ],
        "additionalProperties": false,
        "properties": {
          "version": {
            "type": "string",
            "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "by": {
            "type": "string",
            "minLength": 1
          },
          "checks": {
            "type": "object",
            "required": [
              "digest"
            ],
            "additionalProperties": true,
            "properties": {
              "digest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "concerns": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "high": {
                "type": "integer",
                "minimum": 0
              },
              "medium": {
                "type": "integer",
                "minimum": 0
              },
              "low": {
                "type": "integer",
                "minimum": 0
              },
              "licensed": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  }
}
