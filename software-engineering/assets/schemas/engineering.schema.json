{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/markov-root/skills/schemas/engineering/v1.json",
  "title": "Engineering project policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "project", "checks"],
  "properties": {
    "version": { "const": 1 },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["risk", "core_outcome"],
      "properties": {
        "risk": { "enum": ["low", "moderate", "high", "critical"] },
        "core_outcome": { "$ref": "#/$defs/nonempty" },
        "documents": { "$ref": "#/$defs/paths" }
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "generated": { "$ref": "#/$defs/globs" },
        "vendored": { "$ref": "#/$defs/globs" },
        "sensitive": { "$ref": "#/$defs/globs" },
        "forbidden": { "$ref": "#/$defs/globs" }
      }
    },
    "checks": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/name" },
      "additionalProperties": { "$ref": "#/$defs/check" }
    },
    "profiles": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/name" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["checks"],
        "properties": { "checks": { "$ref": "#/$defs/names" } }
      }
    },
    "classifiers": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/name" },
      "additionalProperties": { "$ref": "#/$defs/globs" }
    },
    "fitness": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "check", "rationale"],
        "properties": {
          "name": { "$ref": "#/$defs/name" },
          "check": { "$ref": "#/$defs/name" },
          "rationale": { "$ref": "#/$defs/nonempty" },
          "references": { "$ref": "#/$defs/paths" },
          "applies_to": { "$ref": "#/$defs/globs" },
          "exceptions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "reason", "expires"],
              "properties": {
                "path": { "$ref": "#/$defs/nonempty" },
                "reason": { "$ref": "#/$defs/nonempty" },
                "expires": { "type": "string", "format": "date" }
              }
            }
          }
        }
      }
    },
    "generated": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "sources", "outputs", "command"],
        "properties": {
          "name": { "$ref": "#/$defs/name" },
          "sources": { "$ref": "#/$defs/nonempty_globs" },
          "outputs": { "$ref": "#/$defs/nonempty_globs" },
          "command": { "$ref": "#/$defs/command" },
          "cwd": { "$ref": "#/$defs/nonempty" }
        }
      }
    },
    "docs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "include": { "$ref": "#/$defs/globs" },
        "required_headings": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonempty" },
          "uniqueItems": true
        },
        "forbid_legacy_links": { "type": "boolean" },
        "currency": { "$ref": "#/$defs/document_currency" }
      }
    },
    "reviewers": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/name" },
      "additionalProperties": { "$ref": "#/$defs/reviewer" }
    },
    "task_inventory": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "include": { "$ref": "#/$defs/globs" },
        "handoffs": { "$ref": "#/$defs/globs" },
        "decisions": { "$ref": "#/$defs/globs" },
        "planning": { "$ref": "#/$defs/task_planning" }
      }
    },
    "approval_required": { "$ref": "#/$defs/names" }
  },
  "$defs": {
    "nonempty": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
    "names": {
      "type": "array",
      "items": { "$ref": "#/$defs/name" },
      "uniqueItems": true
    },
    "paths": {
      "type": "array",
      "items": { "$ref": "#/$defs/nonempty" },
      "uniqueItems": true
    },
    "globs": {
      "type": "array",
      "items": { "$ref": "#/$defs/nonempty" },
      "uniqueItems": true
    },
    "nonempty_globs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/nonempty" },
      "uniqueItems": true
    },
    "planning_value": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,62}$"
    },
    "planning_values": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/planning_value" },
      "uniqueItems": true
    },
    "task_planning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fields"],
      "properties": {
        "fields": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/name" },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["values"],
            "properties": {
              "values": { "$ref": "#/$defs/planning_values" },
              "order": { "$ref": "#/$defs/planning_values" }
            }
          }
        },
        "default_order": { "$ref": "#/$defs/names" }
      }
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "document_currency": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "roles": {
          "type": "array",
          "items": { "$ref": "#/$defs/document_role" }
        },
        "required_current_truth": { "$ref": "#/$defs/paths" },
        "done_task_evidence": { "$ref": "#/$defs/done_task_evidence" }
      }
    },
    "document_role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "include", "index", "id_prefix_digits"],
      "dependentRequired": {
        "states": ["current_state"],
        "current_state": ["states"]
      },
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "include": { "$ref": "#/$defs/nonempty_globs" },
        "index": { "$ref": "#/$defs/nonempty" },
        "id_prefix_digits": { "type": "integer", "minimum": 1, "maximum": 12 },
        "contract": { "$ref": "#/$defs/document_contract" },
        "states": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/nonempty" },
          "uniqueItems": true
        },
        "current_state": { "$ref": "#/$defs/nonempty" }
      }
    },
    "document_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "role"],
      "properties": {
        "version": { "const": 1 },
        "role": {
          "enum": [
            "task",
            "adr",
            "audit",
            "research",
            "lesson",
            "handoff",
            "specification",
            "knowledge",
            "reference",
            "standard",
            "guide",
            "roadmap",
            "changelog",
            "runbook",
            "index",
            "template"
          ]
        },
        "carrier": { "const": "frontmatter" },
        "metadata_key": { "const": "engineering_document" }
      }
    },
    "done_task_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["include", "headings"],
      "properties": {
        "include": { "$ref": "#/$defs/nonempty_globs" },
        "headings": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonempty" },
          "uniqueItems": true
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command"],
      "properties": {
        "command": { "$ref": "#/$defs/command" },
        "version_command": { "$ref": "#/$defs/command" },
        "applies_to": { "$ref": "#/$defs/globs" },
        "cwd": { "$ref": "#/$defs/nonempty" },
        "timeout_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 86400
        },
        "max_output_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000000
        },
        "redact": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonempty" },
          "uniqueItems": true
        }
      }
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "command", "network", "profiles"],
      "properties": {
        "adapter": { "$ref": "#/$defs/name" },
        "command": { "$ref": "#/$defs/command" },
        "version_command": { "$ref": "#/$defs/command" },
        "cwd": { "$ref": "#/$defs/nonempty" },
        "timeout_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 86400
        },
        "max_output_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000000
        },
        "redact": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonempty" },
          "uniqueItems": true
        },
        "network": { "enum": ["none", "optional", "required"] },
        "blocking": { "type": "boolean" },
        "profiles": {
          "type": "array",
          "items": {
            "enum": [
              "intent-diff",
              "test-adequacy",
              "claim-evidence",
              "system-coherence",
              "risk"
            ]
          },
          "uniqueItems": true
        },
        "owner": { "$ref": "#/$defs/nonempty" },
        "expected_provider": { "$ref": "#/$defs/nonempty" },
        "expected_model": { "$ref": "#/$defs/nonempty" },
        "exception_reason": { "$ref": "#/$defs/nonempty" },
        "exception_expires": { "type": "string", "format": "date" },
        "applies_to": { "$ref": "#/$defs/globs" }
      }
    }
  }
}
