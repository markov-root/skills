{
  "$id": "https://cesia.org/schemas/debate.task-family-input/1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "anyOf": [
          {
            "not": {
              "required": [
                "protocol"
              ]
            }
          },
          {
            "properties": {
              "protocol": {
                "const": "delphi"
              }
            },
            "required": [
              "protocol"
            ]
          }
        ]
      },
      "then": {
        "properties": {
          "aggregator": {
            "enum": [
              "arbitrator_select",
              null
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "protocol": {
            "const": "idea"
          }
        },
        "required": [
          "protocol"
        ]
      },
      "then": {
        "properties": {
          "aggregator": {
            "enum": [
              "statistical",
              null
            ]
          }
        }
      }
    }
  ],
  "description": "Portable task-family ask independent of project layout and cast selection.",
  "properties": {
    "aggregator": {
      "anyOf": [
        {
          "enum": [
            "arbitrator_select",
            "statistical",
            "vote"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Aggregator"
    },
    "context": {
      "default": "",
      "maxLength": 2000000,
      "title": "Context",
      "type": "string"
    },
    "criteria": {
      "default": "",
      "maxLength": 500000,
      "title": "Criteria",
      "type": "string"
    },
    "extensions": {
      "additionalProperties": true,
      "title": "Extensions",
      "type": "object"
    },
    "protocol": {
      "enum": [
        "delphi",
        "idea"
      ],
      "title": "Protocol",
      "type": "string"
    },
    "question": {
      "maxLength": 500000,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Question",
      "type": "string"
    },
    "schema_id": {
      "const": "debate.task-family-input",
      "title": "Schema Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_id",
    "schema_version",
    "protocol",
    "question"
  ],
  "title": "TaskFamilyInput",
  "type": "object",
  "x-schema-id": "debate.task-family-input",
  "x-schema-version": "1.0.0"
}
