{
  "$id": "https://cesia.org/schemas/debate.profile/1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "protocol": {
            "const": "delphi"
          }
        },
        "required": [
          "protocol"
        ]
      },
      "then": {
        "properties": {
          "aggregator": {
            "const": "arbitrator_select"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "protocol": {
            "const": "idea"
          }
        },
        "required": [
          "protocol"
        ]
      },
      "then": {
        "properties": {
          "aggregator": {
            "const": "statistical"
          }
        }
      }
    }
  ],
  "description": "Versioned profile preset contract; execution wiring remains task 0051.",
  "properties": {
    "aggregator": {
      "enum": [
        "arbitrator_select",
        "statistical",
        "vote"
      ],
      "title": "Aggregator",
      "type": "string"
    },
    "description": {
      "default": "",
      "maxLength": 100000,
      "title": "Description",
      "type": "string"
    },
    "extensions": {
      "additionalProperties": true,
      "title": "Extensions",
      "type": "object"
    },
    "has_adversary": {
      "title": "Has Adversary",
      "type": "boolean"
    },
    "n_proposers": {
      "maximum": 256,
      "minimum": 1,
      "title": "N Proposers",
      "type": "integer"
    },
    "name": {
      "maxLength": 63,
      "minLength": 1,
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,62})$",
      "title": "Name",
      "type": "string"
    },
    "protocol": {
      "enum": [
        "delphi",
        "idea"
      ],
      "title": "Protocol",
      "type": "string"
    },
    "schema_id": {
      "const": "debate.profile",
      "title": "Schema Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_id",
    "schema_version",
    "name",
    "protocol",
    "n_proposers",
    "has_adversary",
    "aggregator"
  ],
  "title": "ProfileInput",
  "type": "object",
  "x-schema-id": "debate.profile",
  "x-schema-version": "1.0.0"
}
