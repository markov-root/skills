{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reusable LLM judge rubric",
  "type": "object",
  "required": ["schema_version", "rubric_id", "version", "evaluation_mode", "task", "criteria", "abstention", "aggregate"],
  "properties": {
    "schema_version": {"const": 1},
    "rubric_id": {"type": "string"},
    "version": {"type": "string"},
    "evaluation_mode": {"enum": ["pointwise", "pairwise", "ranking", "reference-based"]},
    "task": {"type": "string"},
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "description", "weight", "critical", "anchors"],
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "description": {"type": "string"},
          "weight": {"type": "number", "exclusiveMinimum": 0},
          "critical": {"type": "boolean"},
          "anchors": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": ["score", "observable"],
              "properties": {
                "score": {"type": "integer"},
                "observable": {"type": "string"}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "abstention": {
      "type": "object",
      "required": ["allowed", "label", "when"],
      "properties": {
        "allowed": {"const": true},
        "label": {"const": "UNKNOWN"},
        "when": {"type": "string"}
      },
      "additionalProperties": false
    },
    "aggregate": {
      "type": "object",
      "required": ["verdicts", "critical_failure_verdict"],
      "properties": {
        "verdicts": {
          "type": "array",
          "items": {"enum": ["PASS", "FAIL", "TIE", "A", "B", "UNKNOWN"]}
        },
        "critical_failure_verdict": {"const": "FAIL"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
