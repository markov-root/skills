#!/usr/bin/env bash
# cache-check — prompt-cache efficiency (task 0012). stdlib-only, no deps.
# Package lives beside this script in the installed skill.
set -euo pipefail
SCRIPT_DIR="$(cd -- "$(dirname -- "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
export PYTHONPATH="$SCRIPT_DIR${PYTHONPATH:+:$PYTHONPATH}"
exec python3 -m situational_awareness.cache "$@"
