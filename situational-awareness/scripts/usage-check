#!/usr/bin/env bash
# usage-check (ported) — quota half of situational-awarenessness (ADR-0005). Parallel to the
# legacy ~/.claude/usage/check-usage.sh during the parity window; does NOT replace it.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
export PYTHONPATH="$SCRIPT_DIR${PYTHONPATH:+:$PYTHONPATH}"
exec python3 -m situational_awareness.quota "$@"
